<?xml version="1.0" encoding="utf-8"?>
<!--
  Microbite "bite" mark, converted from svg/microbite-fav.svg.
  Used as the foreground layer of the adaptive icon (Android 8+).
  The artwork is scaled to ~62% and centred so it sits inside the
  adaptive-icon safe zone (the outer area can be cropped by the launcher mask).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:name="mark"
        android:pivotX="255"
        android:pivotY="256"
        android:scaleX="0.62"
        android:scaleY="0.62">

        <!-- Bite silhouette acts as the clip for everything below it. -->
        <clip-path android:pathData="M43.8,256c0,136.6,110.8,247.4,247.4,247.4c67.2,0,128.2-26.8,172.8-70.4c3.5-3.4,7.3-12.9,0.1-20.6L279.6,286.1c-24.6-25.9,0-47.6,0-47.6L436.6,86.7c10.1-13.4,5.5-26.7-0.1-30.8C402.6,31.4,351.2,8.1,291.2,8.6C154.6,9.6,43.8,119.3,43.8,256z" />

        <!-- Orange→red radial body. -->
        <path android:pathData="M0,0h512v512h-512z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="289"
                    android:centerY="510"
                    android:gradientRadius="504">
                    <item android:offset="0.1" android:color="#FCBA63" />
                    <item android:offset="0.51" android:color="#E76E33" />
                    <item android:offset="0.94" android:color="#EC1C24" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Glossy orange→white inner highlight. -->
        <path android:pathData="M81.1,202.5c0,99.3,94,57.5,210.4,57.5s210.2,41.8,210.2,-57.5S407.6,22.7,291.5,22.7S81.1,103.2,81.1,202.5z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="291.4"
                    android:startY="268.7"
                    android:endX="291.4"
                    android:endY="22.7">
                    <item android:offset="0.12" android:color="#E76E33" />
                    <item android:offset="1.0" android:color="#FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- White dot. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M325.2,105.9c0,15.3,12.4,27.8,27.8,27.8s27.8,-12.5,27.8,-27.8S368.3,78.1,353,78.1S325.2,90.5,325.2,105.9z" />
    </group>
</vector>
